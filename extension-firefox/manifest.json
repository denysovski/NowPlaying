{
  "manifest_version": 3,
  "name": "NowPlaying for OBS",
  "version": "1.0.3",
  "description": "Sends the song playing on YouTube or SoundCloud to the NowPlaying app for your OBS overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://m.soundcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*",
        "https://m.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nowplaying@change-me-to-your-name",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
